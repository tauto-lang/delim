import std::builtin::macro {
  Syn,
  SynBinder,
  SynCtx,
  SynExpr,
  SynIdent,
  SynSpan,
  SynToken,
  macro_error
}
import delim::tree { Prop, Tree }
import "markup.taut" { Attr, HtmlAttr, HtmlKind, starts_with, tag_refusal, url_refusal }
import "ui.taut" { AttrText, lifted_part, on_event, view_in, view_value, view_value_in }
import delim::signal { memo, readonly }
import delim::view { View, ViewDialect, view }

// `view!` of the web elements: the dialect of `delim::view` for HTML. A tag is one of the
// elements `policy.taut` lists (or a custom element with a dash in its name), an attribute one of
// its attributes, `data-*` or `aria-*`; what the renderers would refuse is an error of the program.
//
//   view!(
//     ```view
//     $t <div class="row"><p>"Count: " $text_dyn(t, () => decimal(get(n)))</p>
//       <button aria-label="Add" on:press=${(d: EventData) => update(n, (x: u64) => x + 1)}>"+"</button>
//     </div>
//     ```
//   )
//
// The expression first is the tree. An attribute is a quoted text, fixed, or `${e}` with `e` a
// text, followed; `on:press` and the other event names take a handler of the event's data. A
// child is an element, a quoted text, or `$e` with `e` a node.

pub fn view_url_attr_names(): List(Text) {
  ["action", "cite", "formaction", "href", "poster", "src"]
}

fn text_in(t: Text, l: List(Text)): Bool ! {div, overflow} {
  match l {
    Nil => false
    Cons(x, rest) => x == t || text_in(t, rest)
  }
}

fn has_dash(t: Text, i: u64): Bool ! {div, overflow} {
  match Text::byte(t, i) {
    None => false
    Some(b) => U64::of_u8(b) == 45 || has_dash(t, i + 1)
  }
}

