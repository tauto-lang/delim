import std::base { Nat }

// What the renderers may write, decided on the bytes so that the kernel reads it. Names are
// lists of byte values, with the name in a comment: the file does not import `std::text`,
// whose names would meet the prelude's in every file that imports this one: a tag name
// from a list of elements that run no code, an attribute name from a list of attributes that
// run none, and a URL whose scheme is one that loads a page or an address. Anything else is
// refused. The lists name what is allowed, so an element or attribute a browser adds later
// is refused until it is added here.

pub fn same_bytes(a: List(Nat), b: List(Nat)): Bool {
  match a {
    Nil => ⊢ Bool from match b {
      Nil => true
      Cons(y, ys) => false
    }
    Cons(x, xs) => ⊢ Bool from match b {
      Nil => false
      Cons(y, ys) => Bool::and(Nat::eq(x, y), same_bytes(xs, ys))
    }
  }
}

pub fn begins_with(w: List(Nat), p: List(Nat)): Bool {
  match p {
    Nil => true
    Cons(y, ys) => ⊢ Bool from match w {
      Nil => false
      Cons(x, xs) => Bool::and(Nat::eq(x, y), begins_with(xs, ys))
    }
  }
}

fn one_of(w: List(Nat), l: List(List(Nat))): Bool {
  match l {
    Nil => false
    Cons(t, rest) => Bool::or(same_bytes(w, t), one_of(w, rest))
  }
}

fn has_byte(w: List(Nat), c: Nat): Bool {
  match w {
    Nil => false
    Cons(x, rest) => Bool::or(Nat::eq(x, c), has_byte(rest, c))
  }
}

pub fn is_lower(c: Nat): Bool { Bool::and(Nat::le(97, c), Nat::le(c, 122)) }

pub fn is_digit_byte(c: Nat): Bool { Bool::and(Nat::le(48, c), Nat::le(c, 57)) }

// The bytes after the first of a name: lowercase letters, digits and `-`.
fn name_rest_ok(w: List(Nat)): Bool {
  match w {
    Nil => true
    Cons(c, rest) => Bool::and(
      Bool::or(is_lower(c), Bool::or(is_digit_byte(c), Nat::eq(c, 45))),
      name_rest_ok(rest)
    )
  }
}

// A name of a tag or an attribute: a lowercase letter, then lowercase letters, digits and `-`.
fn name_ok(w: List(Nat)): Bool {
  match w {
    Nil => false
    Cons(c, rest) => Bool::and(is_lower(c), name_rest_ok(rest))
  }
}

