pub fn data_prefix(): List(Nat) { [100, 97, 116, 97, 45] } // data-

pub fn aria_prefix(): List(Nat) { [97, 114, 105, 97, 45] } // aria-

pub fn style_name(): List(Nat) { [115, 116, 121, 108, 101] } // style

pub fn display_contents(): List(Nat) {
  [100, 105, 115, 112, 108, 97, 121, 58, 99, 111, 110, 116, 101, 110, 116, 115] // display:contents
}

pub module Attr {
  // Whether the attribute `w` may be written: one of `attrs`, or a `data-…` or `aria-…`
  // attribute.
  pub fn allowed(w: List(Nat)): Bool {
    Bool::and(
      name_ok(w),
      Bool::or(
        one_of(w, attrs()),
        Bool::or(begins_with(w, data_prefix()), begins_with(w, aria_prefix()))
      )
    )
  }

  pub fn is_url(w: List(Nat)): Bool { one_of(w, url_attrs()) }

  // ---- URLs -------------------------------------------------------------------------------------

  // Whether `name="value"` may be written. `style` is written only as `display:contents`, which
  // the renderers give the elements that hold a group, an island or trusted HTML.
  pub fn value_allowed(name: List(Nat), value: List(Nat)): Bool {
    Bool::or(
      Bool::and(
        Attr::allowed(name),
        ⊢ Bool from match Attr::is_url(name) {
          true => url_allowed(value)
          false => true
        }
      ),
      Bool::and(same_bytes(name, style_name()), same_bytes(value, display_contents()))
    )
  }
}

// The attributes of `attrs` whose value is a URL.
pub fn url_attrs(): List(List(Nat)) {
  [
    [97, 99, 116, 105, 111, 110], // action
    [99, 105, 116, 101], // cite
    [102, 111, 114, 109, 97, 99, 116, 105, 111, 110], // formaction
    [104, 114, 101, 102], // href
    [112, 111, 115, 116, 101, 114], // poster
    [115, 114, 99] // src
  ]
}

fn ascii_lower(c: Nat): Nat {
  match Bool::and(Nat::le(65, c), Nat::le(c, 90)) {
    true => Nat::add(c, 32)
    false => c
  }
}

// The bytes of a URL before its first `/`, `?` or `#`, lowercased, without the spaces and
// control bytes a browser skips (it skips fewer, so what it reads as a scheme is read here
// too).
fn url_head(w: List(Nat)): List(Nat) {
  match w {
    Nil => Nil
    Cons(c, rest) => ⊢ List(Nat) from match Bool::or(
      Nat::eq(c, 47),
      Bool::or(Nat::eq(c, 63), Nat::eq(c, 35))
    ) {
      true => Nil
      false => ⊢ List(Nat) from match Nat::le(c, 32) {
        true => url_head(rest)
        false => Cons(ascii_lower(c), url_head(rest))
      }
    }
  }
}

// The bytes before the first `:`.
fn before_colon(w: List(Nat)): List(Nat) {
  match w {
    Nil => Nil
    Cons(c, rest) => ⊢ List(Nat) from match Nat::eq(c, 58) {
      true => Nil
      false => Cons(c, before_colon(rest))
    }
  }
}

pub fn schemes(): List(List(Nat)) {
  [
    [104, 116, 116, 112], // http
    [104, 116, 116, 112, 115], // https
    [109, 97, 105, 108, 116, 111], // mailto
    [116, 101, 108] // tel
  ]
}

// `&`, `<`, `>` and `"`: a character reference could spell a `:` or a scheme, and escaping
// the others would add an `&`.
fn has_markup(h: List(Nat)): Bool {
  Bool::or(Bool::or(has_byte(h, 38), has_byte(h, 60)), Bool::or(has_byte(h, 62), has_byte(h, 34)))
}

fn head_allowed(h: List(Nat)): Bool {
  match has_markup(h) {
    true => false
    false => ⊢ Bool from match has_byte(h, 58) {
      true => one_of(before_colon(h), schemes())
      // No scheme: a path relative to the page.
      false => true
    }
  }
}

// Whether the URL `w` may be written: one relative to the page, or one whose scheme is `http`,
// `https`, `mailto` or `tel`; and no `&`, `<`, `>` or `"` before its first `/`, `?` or `#`.
pub fn url_allowed(w: List(Nat)): Bool { head_allowed(url_head(w)) }
