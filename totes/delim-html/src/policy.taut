// Whether the tag `w` may be written: one of `tags`, or the name of a custom element (a name
// with a `-`), which runs only the code the page defines for it.
pub fn tag_allowed(w: List(Nat)): Bool {
  Bool::and(name_ok(w), Bool::or(one_of(w, tags()), has_byte(w, 45)))
}

// Elements that have no end tag.
pub fn void_tags(): List(List(Nat)) {
  [
    [97, 114, 101, 97], // area
    [98, 114], // br
    [99, 111, 108], // col
    [104, 114], // hr
    [105, 109, 103], // img
    [105, 110, 112, 117, 116], // input
    [115, 111, 117, 114, 99, 101], // source
    [116, 114, 97, 99, 107], // track
    [119, 98, 114] // wbr
  ]
}

pub fn tag_void(w: List(Nat)): Bool { one_of(w, void_tags()) }

