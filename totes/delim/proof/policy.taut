import std::text { Text }
import "../../delim-html/src/policy.taut" {
  aria_prefix,
  attrs,
  data_prefix,
  display_contents,
  schemes,
  style_name,
  tags,
  url_attrs,
  void_tags
}

// The lists of `policy.taut` are byte values with the name in a comment; these say that the
// bytes spell the names.

