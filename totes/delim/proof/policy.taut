theorem url_attrs_spell(): url_attrs() = [
  Text::bytes("action"),
  Text::bytes("cite"),
  Text::bytes("formaction"),
  Text::bytes("href"),
  Text::bytes("poster"),
  Text::bytes("src")
] {
  Refl
}

theorem schemes_spell(): schemes() = [
  Text::bytes("http"),
  Text::bytes("https"),
  Text::bytes("mailto"),
  Text::bytes("tel")
] {
  Refl
}

theorem literals_spell(): Eq(
  List(List(Nat)),
  [data_prefix(), aria_prefix(), style_name(), display_contents()],
  [
    Text::bytes("data-"),
    Text::bytes("aria-"),
    Text::bytes("style"),
    Text::bytes("display:contents")
  ]
) {
  Refl
}
